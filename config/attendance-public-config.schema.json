{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ux-assistant:attendance-public-config:v2",
  "title": "UX Assistant Attendance public runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups", "database", "provider", "webapp", "ai", "sheets", "scheduler", "worker", "observability", "credentials"],
  "properties": {
    "groups": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "roster"],
        "properties": {
          "title": { "$ref": "#/$defs/groupTitle" },
          "roster": { "type": "string", "enum": ["main", "alt"] },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 12,
            "items": { "$ref": "#/$defs/groupCapability" },
            "default": ["standard-checkin"]
          }
        }
      },
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["gateway", "attendance"]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalName", "applicationRole", "connectionSecretRef"],
      "properties": {
        "logicalName": { "const": "attendance_v1" },
        "applicationRole": { "const": "ux_attendance_app" },
        "connectionSecretRef": { "const": "attendance_database_url" }
      },
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance"]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "internalServiceAlias"],
      "properties": {
        "host": { "type": "string", "enum": ["0.0.0.0", "127.0.0.1"] },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535, "default": 19083 },
        "internalServiceAlias": { "const": "attendance-provider" }
      },
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance"]
    },
    "webapp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "publicBaseUrl", "host", "port", "timezone", "browserDev", "signingSecretRef"],
      "properties": {
        "enabled": { "type": "boolean" },
        "publicBaseUrl": { "$ref": "#/$defs/attendancePublicBaseUrl" },
        "host": { "type": "string", "enum": ["0.0.0.0", "127.0.0.1"] },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "timezone": { "$ref": "#/$defs/timezone" },
        "browserDev": { "const": false },
        "signingSecretRef": { "const": "attendance_webapp_session_signing" }
      },
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance", "webapp"]
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "extractBackend", "apiBaseUrl", "model", "textModel", "mode", "maxClockSkewMinutes", "timeoutSeconds", "trustSenderWhenNameUnreadable", "nameVerify", "clockFallbackSendTime", "ocr", "premium", "apiKeySecretRef"],
      "properties": {
        "enabled": { "type": "boolean" },
        "extractBackend": { "type": "string", "enum": ["ollama", "ocr_only", "ocr_text_llm", "zhipu"] },
        "apiBaseUrl": { "$ref": "#/$defs/httpUrl" },
        "model": { "$ref": "#/$defs/publicName" },
        "textModel": { "$ref": "#/$defs/publicName" },
        "mode": { "type": "string", "enum": ["assist", "required"] },
        "maxClockSkewMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "trustSenderWhenNameUnreadable": { "type": "boolean" },
        "nameVerify": { "type": "string", "enum": ["vision", "ocr", "both"] },
        "clockFallbackSendTime": { "type": "boolean" },
        "ocr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "easyOcrGpu", "maxConcurrent"],
          "properties": {
            "engine": { "type": "string", "enum": ["tesseract", "easyocr"] },
            "easyOcrGpu": { "type": "boolean" },
            "maxConcurrent": { "type": "integer", "minimum": 1, "maximum": 32 }
          }
        },
        "apiKeySecretRef": { "const": "attendance_ai_api_key" },
        "premium": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "apiBaseUrl", "model", "apiKeySecretRef"],
          "properties": {
            "enabled": { "type": "boolean" },
            "apiBaseUrl": { "$ref": "#/$defs/httpUrl" },
            "model": { "$ref": "#/$defs/publicName" },
            "apiKeySecretRef": { "const": "attendance_premium_ai_api_key" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "required" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "enabled": { "const": true },
              "clockFallbackSendTime": { "const": false },
              "trustSenderWhenNameUnreadable": { "const": false }
            }
          }
        }
      ],
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance"]
    },
    "sheets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "syncIntervalSeconds", "timezone", "yearMonth", "primary", "alternate", "profiles", "credentialsSecretRef"],
      "properties": {
        "enabled": { "type": "boolean" },
        "syncIntervalSeconds": { "type": "integer", "minimum": 60, "maximum": 604800 },
        "timezone": { "$ref": "#/$defs/timezone" },
        "yearMonth": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$" },
        "primary": { "$ref": "#/$defs/sheetObject" },
        "alternate": { "$ref": "#/$defs/sheetObject" },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["remoteDiff", "testGroup", "bbq"],
          "properties": {
            "remoteDiff": {
              "allOf": [
                { "$ref": "#/$defs/sheetProfile" },
                {
                  "type": "object",
                  "properties": {
                    "spreadsheetId": { "$ref": "#/$defs/spreadsheetId" },
                    "sheetGid": { "$ref": "#/$defs/sheetGid" }
                  }
                }
              ],
              "unevaluatedProperties": false
            },
            "testGroup": {
              "allOf": [
                { "$ref": "#/$defs/sheetProfile" },
                {
                  "type": "object",
                  "required": ["slackCheckin"],
                  "properties": {
                    "slackCheckin": { "type": "boolean" },
                    "shiftSpreadsheetId": { "$ref": "#/$defs/spreadsheetId" },
                    "shiftSheetGid": { "$ref": "#/$defs/sheetGid" },
                    "attendanceSpreadsheetId": { "$ref": "#/$defs/spreadsheetId" },
                    "attendanceSheetGid": { "$ref": "#/$defs/sheetGid" },
                    "attendanceSheetTitle": { "$ref": "#/$defs/sheetTitle" }
                  }
                }
              ],
              "unevaluatedProperties": false
            },
            "bbq": {
              "allOf": [
                { "$ref": "#/$defs/sheetProfile" },
                {
                  "type": "object",
                  "properties": {
                    "spreadsheetId": { "$ref": "#/$defs/spreadsheetId" },
                    "sheetTitle": { "$ref": "#/$defs/sheetTitle" }
                  }
                }
              ],
              "unevaluatedProperties": false
            }
          }
        },
        "credentialsSecretRef": { "const": "attendance_google_service_account" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "properties": { "primary": { "required": ["spreadsheetId"] } } }
        },
        {
          "if": {
            "properties": { "profiles": { "properties": { "remoteDiff": { "properties": { "enabled": { "const": true } } } } } }
          },
          "then": { "properties": { "profiles": { "properties": { "remoteDiff": { "required": ["spreadsheetId"] } } } } }
        },
        {
          "if": {
            "properties": { "profiles": { "properties": { "testGroup": { "properties": { "enabled": { "const": true } } } } } }
          },
          "then": { "properties": { "profiles": { "properties": { "testGroup": { "required": ["shiftSpreadsheetId", "attendanceSpreadsheetId", "attendanceSheetTitle"] } } } } }
        },
        {
          "if": {
            "properties": { "profiles": { "properties": { "bbq": { "properties": { "enabled": { "const": true } } } } } }
          },
          "then": { "properties": { "profiles": { "properties": { "bbq": { "required": ["spreadsheetId", "sheetTitle"] } } } } }
        }
      ],
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance"]
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "pollSeconds", "leaseSeconds", "timezone", "dailySummaryEnabled", "dailySummaryTime", "dailySummarySkipDate", "dailyReportEnabled", "dailyReportTime"],
      "properties": {
        "enabled": { "type": "boolean" },
        "pollSeconds": { "type": "number", "minimum": 0.1, "maximum": 3600 },
        "leaseSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "timezone": { "$ref": "#/$defs/timezone" },
        "dailySummaryEnabled": { "type": "boolean" },
        "dailySummaryTime": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "dailySummarySkipDate": { "type": "string", "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}(?:,[0-9]{4}-[0-9]{2}-[0-9]{2})*)$" },
        "dailyReportEnabled": { "type": "boolean" },
        "dailyReportTime": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
      },
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance"]
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logLevel"],
      "properties": {
        "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] }
      },
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance"]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "pollSeconds", "leaseSeconds", "batchSize", "timeoutSeconds", "maximumAcceptanceAttempts"],
      "properties": {
        "enabled": { "type": "boolean" },
        "pollSeconds": { "type": "number", "minimum": 0.1, "maximum": 3600 },
        "leaseSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "timeoutSeconds": { "type": "number", "minimum": 0.1, "maximum": 3600 },
        "maximumAcceptanceAttempts": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance"]
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gatewayToAttendanceBearerRef", "attendanceToGatewayBearerRef"],
      "properties": {
        "gatewayToAttendanceBearerRef": { "const": "gateway_to_attendance_bearer" },
        "attendanceToGatewayBearerRef": { "const": "attendance_to_gateway_bearer" }
      },
      "x-ownerComponent": "attendance",
      "x-restartComponents": ["attendance", "gateway"]
    }
  },
  "$defs": {
    "logicalRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 128
    },
    "publicName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$" },
    "groupTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f]).+$"
    },
    "groupCapability": {
      "type": "string",
      "enum": [
        "standard-checkin",
        "premium-ai",
        "remote-diff-checkin",
        "employee-id-only-checkin",
        "pc-only-screenshot",
        "visible-texts-identity-correction",
        "ai-dry-run-no-persist",
        "test-group-google-sheets",
        "bbq-google-sheets",
        "leave-mutual-exclusion",
        "leave-back-copy-fallback",
        "export-scope"
      ]
    },
    "sheetProfile": {
      "type": "object",
      "required": ["enabled", "timezone"],
      "properties": {
        "enabled": { "type": "boolean" },
        "timezone": { "$ref": "#/$defs/timezone" }
      }
    },
    "sheetObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spreadsheetId": { "$ref": "#/$defs/spreadsheetId" },
        "sheetGid": { "$ref": "#/$defs/sheetGid" }
      }
    },
    "spreadsheetId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sheetGid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "sheetTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(?![^/]*(?:prod|production))[A-Za-z0-9.-]+(?::[0-9]+)?(?:/.*)?$"
    },
    "timezone": { "type": "string", "pattern": "^[A-Za-z_]+(?:/[A-Za-z_+-]+)+$" },
    "attendancePublicBaseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?![^/]*(?:prod|production))[A-Za-z0-9.-]+(?::[0-9]+)?/attendance/?$"
    }
  }
}
