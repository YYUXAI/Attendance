TELEGRAM_BOT_TOKEN=your_bot_token_here
ATTENDANCE_BOT_OWNER=legacy_attendance
ATTENDANCE_DOTENV_OVERRIDE=1

# polling=本地 python main.py；webhook=接入 Gateway（Docker 默认）
ATTENDANCE_RUN_MODE=polling
ATTENDANCE_WEBHOOK_RUN_WORKERS=0
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8001
WEBHOOK_SECRET_TOKEN=
# 留空时：polling 模式注册 commands/menu，webhook 模式交给统一壳管理
ATTENDANCE_REGISTER_BOT_COMMANDS=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=attendance_bd
DB_USER=postgres
DB_PASSWORD=your_db_password

# 打卡截图 AI（智谱 GLM 视觉，国内 open.bigmodel.cn）
CHECKIN_AI_ENABLED=true
CHECKIN_AI_EXTRACT_BACKEND=zhipu
CHECKIN_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CHECKIN_AI_API_KEY=your_zhipu_api_key
CHECKIN_AI_MODEL=glm-4v-flash

# 专群智谱（测试群 + Y-UX-KQBBQ）：新 API Key + glm-4.6v；其它群仍用上面默认 key/模型
CHECKIN_AI_PREMIUM_ENABLED=true
CHECKIN_AI_PREMIUM_API_KEY=your_premium_zhipu_api_key
CHECKIN_AI_PREMIUM_MODEL=glm-4.6v
CHECKIN_AI_PREMIUM_CHAT_IDS=<telegram_chat_id>,<telegram_chat_id>
CHECKIN_AI_PREMIUM_GROUP_TITLES=测试群,Y-UX-KQBBQ

CHECKIN_AI_MODE=required
CHECKIN_AI_MAX_CLOCK_SKEW_MINUTES=30
CHECKIN_AI_TIMEOUT_SECONDS=180
CHECKIN_AI_TRUST_SENDER_WHEN_NAME_UNREADABLE=false
CHECKIN_AI_NAME_VERIFY=vision
CHECKIN_AI_CLOCK_FALLBACK_SEND_TIME=false

# HTTP / 班次 Web App
DAILY_ATTENDANCE_REPORT_API_ENABLED=true
DAILY_ATTENDANCE_REPORT_API_HOST=127.0.0.1
DAILY_ATTENDANCE_REPORT_API_PORT=8787
DAILY_ATTENDANCE_REPORT_API_TOKEN=change-me-to-a-random-secret

SHIFT_WEB_ENABLED=true
SHIFT_WEB_APP_PUBLIC_URL=https://your-domain.example.com
SHIFT_WEB_TIMEZONE=Asia/Shanghai
SHIFT_WEB_BROWSER_DEV=false
SHIFT_WEB_HOST=127.0.0.1
SHIFT_WEB_PORT=18084
SHIFT_WEB_INIT_DATA_MAX_AGE_SECONDS=300
SHIFT_WEB_SESSION_TTL_SECONDS=900
SHIFT_WEB_TELEGRAM_BOT_TOKEN=

# Google Sheets 排班表同步（可选）
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_GID=
GOOGLE_SHEETS_CREDENTIALS_JSON=secrets/google_service_account.json
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=14400
GOOGLE_SHEETS_YEAR_MONTH=2026-06
# 备用排班表（MGZ）：全表同步；下列工号的管理员只看 MGZ 表
# GOOGLE_SHEETS_ALT_SPREADSHEET_ID=<google_sheet_id>
# GOOGLE_SHEETS_ALT_SHEET_GID=<sheet_gid>
# GOOGLE_SHEETS_ALT_VIEWER_EMPLOYEE_IDS=<employee_id>,<employee_id>
# 班表镜像：<employee_id>:<employee_id> 表示后者复制前者的排班数据（仅个人数据，不出现在 MGZ 班表列表）
# GOOGLE_SHEETS_MIRROR_EMPLOYEE_IDS=<employee_id>:<employee_id>
# GOOGLE_SHEETS_ALT_ATTENDANCE_CHAT_ID=<telegram_chat_id>

# YYMG-DKQ-(NEW) 工号打卡群（remote_diff + 离返岗 + MGZ 导出打卡来源）
# CHECKIN_REMOTE_DIFF_CHAT_IDS=<telegram_chat_id>
# CHECKIN_REMOTE_DIFF_GROUP_TITLES=YYMG-DKQ-(NEW)
# NEW_ATTENDANCE_TEST_CHAT_ID=<telegram_chat_id>
# CHECKIN_EXPORT_EMPLOYEE_CHAT_OVERRIDES=<employee_id>:<telegram_chat_id>,<employee_id>:<telegram_chat_id>
# YYMG 开班/今日概览/导出排除工号（逗号分隔；设为空字符串可关闭排除）
# YYMG_SUMMARY_EXCLUDE_EMPLOYEE_IDS=<employee_id>
# LEAVE_MUTUAL_EXCLUSION_CHAT_IDS=<telegram_chat_id>,<telegram_chat_id>

# 仅这些群要求 PC 端截图（手机浏览器 / 手机 Telegram 拒绝）
CHECKIN_PC_ONLY_CHAT_IDS=<telegram_chat_id>

# 可选：标准 time.is 仅校验工号（无文件夹）；工号打卡群请用下方 remote_diff
# CHECKIN_EMPLOYEE_ID_ONLY_CHAT_IDS=
# CHECKIN_EMPLOYEE_ID_ONLY_GROUP_TITLES=

# 工号打卡（桌面工号文件夹 + 北京时间，配文仅校验工号）；可配置多群规则一致：
# YYMG-DKQ-(NEW) / 测试群 / New-考勤测试群
# CHECKIN_REMOTE_DIFF_CHAT_IDS=<telegram_chat_id>,<telegram_chat_id>,<telegram_chat_id>
# CHECKIN_REMOTE_DIFF_GROUP_TITLES=YYMG-DKQ-(NEW),测试群,New-考勤测试群

# 工号打卡群专属：打卡成功后同步当月考勤到 Google 表（格式同私聊导出 XLSX）
REMOTE_DIFF_GOOGLE_SHEETS_ENABLED=false
REMOTE_DIFF_GOOGLE_SHEETS_SPREADSHEET_ID=
REMOTE_DIFF_GOOGLE_SHEETS_SHEET_GID=
# 可复用排班同步的服务账号；需对该表有编辑权限
REMOTE_DIFF_GOOGLE_SHEETS_CREDENTIALS_JSON=secrets/google_service_account.json
REMOTE_DIFF_GOOGLE_SHEETS_TIMEZONE=Asia/Shanghai

# Telegram 群「测试群」（勿与 New-考勤测试群 混淆）
# TEST_GROUP_GOOGLE_SHEETS_ENABLED=true
# TEST_GROUP_CHAT_IDS=<telegram_chat_id>
# TEST_GROUP_GROUP_TITLES=测试群
# TEST_GROUP_SHIFT_SPREADSHEET_ID=<google_sheet_id>
# 测试群班表来源（未配置时使用上述默认表）；考勤统计按此表 roster 全员 + 测试群打卡
# TEST_GROUP_SHIFT_SHEET_GID=0
# TEST_GROUP_ATTENDANCE_SPREADSHEET_ID=<google_sheet_id>
# TEST_GROUP_ATTENDANCE_SHEET_GID=0
# 打卡后整表回写 TEST_GROUP_ATTENDANCE（导出布局；每日状态为上班卡/下班卡，月休保留）
# TEST_GROUP_GOOGLE_SHEETS_CREDENTIALS_JSON=secrets/google_service_account.json
# TEST_GROUP_GOOGLE_SHEETS_TIMEZONE=Asia/Shanghai

# BBQ 群（Y-UX-KQBBQ）打卡记录 → 同上考勤表的新 tab「Y-UX-KQBBQ打卡记录」（导出格式+异常标黄）
# BBQ_GOOGLE_SHEETS_ENABLED=true
# BBQ_GOOGLE_SHEETS_CHAT_ID=<telegram_chat_id>
# BBQ_GOOGLE_SHEETS_SPREADSHEET_ID=<google_sheet_id>
# BBQ_GOOGLE_SHEETS_SHEET_TITLE=Y-UX-KQBBQ打卡记录
# BBQ 开班/今日概览/群统计排除工号（逗号分隔；设为空字符串可关闭排除）
# BBQ_SUMMARY_EXCLUDE_EMPLOYEE_IDS=<employee_id>
# 正式群打卡按群对应 roster 严格过滤（不在群对应班表内则不入库）
# FORMAL_GROUP_ROSTER_SOURCE_MAP=<telegram_chat_id>:alt,<telegram_chat_id>:main

# 考勤导出群范围：留空=所有考勤群；指定后仅统计这些群（如 KQBBQ 群）
# CHECKIN_EXPORT_CHAT_IDS=<telegram_chat_id>

# New-考勤测试群 / YYMG-DKQ-(NEW) chat_id；离岗/返岗互斥、Bear/99999 导出覆盖会用到
# NEW_ATTENDANCE_TEST_CHAT_ID=<telegram_chat_id>
# 指定工号导出时强制取某群打卡：工号:chat_id
# CHECKIN_EXPORT_EMPLOYEE_CHAT_OVERRIDES=<employee_id>:<telegram_chat_id>,<employee_id>:<telegram_chat_id>
# 导出镜像：7882:99999 表示 99999 复制 7882 的打卡内容（姓名各用各的）
# CHECKIN_EXPORT_MIRROR_EMPLOYEE_IDS=<employee_id>:<employee_id>
# 离返岗互斥群（可与 NEW_ATTENDANCE_TEST_CHAT_ID 叠加）
# LEAVE_MUTUAL_EXCLUSION_CHAT_IDS=<telegram_chat_id>,<telegram_chat_id>
